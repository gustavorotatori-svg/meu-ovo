{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "Information about the restaurant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "slug": { "type": "string", "description": "Unique URL segment for the restaurant menu" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "ownerId": { "type": "string" },
        "isDeliveryOpen": { "type": "boolean" },
        "isTableOpen": { "type": "boolean" },
        "deliverySettings": {
          "type": "object",
          "properties": {
            "fee": { "type": "number" },
            "estimatedTime": { "type": "string" },
            "minOrder": { "type": "number" }
          }
        },
        "loyaltySettings": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "pointsPerReal": { "type": "number", "description": "Points earned for each R$ 1.00 spent" },
            "redemptionRules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "type": { "type": "string", "enum": ["discount_percent", "free_product"] },
                  "value": { "type": "number", "description": "Discount percentage or productId" },
                  "pointsRequired": { "type": "number" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "ownerId"]
    },
    "LoyaltyProfile": {
      "title": "Loyalty Profile",
      "description": "Points and history for a customer at a restaurant",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerName": { "type": "string" },
        "pointsBalance": { "type": "number" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["earn", "redeem"] },
              "points": { "type": "number" },
              "description": { "type": "string" },
              "orderId": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "required": ["restaurantId", "customerPhone", "pointsBalance"]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["restaurantId", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "A menu item",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "ingredients": { "type": "string" },
        "allergens": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["restaurantId", "categoryId", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "type": { "type": "string", "enum": ["delivery", "table", "pickup"] },
        "tableNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["received", "preparing", "out_for_delivery", "completed", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "type", "items", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon for a restaurant",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["fixed", "percent"] },
        "value": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "usageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "code", "type", "value"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Restaurant settings and profiles"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Menu categories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Menu products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "System orders"
    },
    "/loyalty_profiles/{profileId}": {
      "schema": "LoyaltyProfile",
      "description": "Customer loyalty points"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional coupons"
    }
  }
}
