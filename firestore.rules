rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function runsRestaurant(restaurantId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId
             == request.auth.uid;
    }
    function isOwnerOrAdmin(restaurantId) {
      return runsRestaurant(restaurantId) || isPlatformAdmin();
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default deny
    match /{document=**} { allow read, write: if false; }

    // ─── RESTAURANTS ─────────────────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().slug.matches('^[a-z0-9-]+$')
        && (incoming().createdAt is timestamp || incoming().createdAt is string);
      allow update: if isOwnerOrAdmin(restaurantId)
        && incoming().ownerId == existing().ownerId;
      allow delete: if isOwnerOrAdmin(restaurantId);
    }

    // ─── CATEGORIES ──────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().name is string && incoming().name.size() <= 50
        && incoming().order is number;
      allow update, delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── PRODUCTS ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().price is number && incoming().price >= 0;
      allow update, delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isPlatformAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys()
             .hasOnly(['full_name', 'role', 'createdAt', 'pwaInstallPending',
                       'onboardingComplete', 'customerRating', 'customerRatingCount'])
        && incoming().role == 'customer';
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys()
             .hasOnly(['full_name', 'profile_image_url', 'updatedAt', 'role', 'pwaInstallPending'])
        && (!incoming().keys().contains('role')
            || incoming().role == existing().role
            || (existing().role == 'customer' && incoming().role == 'restaurant'));
      allow delete: if false;
    }

    // ─── TABLES ──────────────────────────────────────────────────────────────
    match /tables/{tableId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin(incoming().restaurantId);
    }

    // ─── ORDERS ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow get: if isOwnerOrAdmin(resource.data.restaurantId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isOwnerOrAdmin(resource.data.restaurantId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if incoming().total is number && incoming().total >= 0
        && incoming().status == 'received'
        && incoming().restaurantId is string
        && incoming().customerPhone is string
        && (incoming().userId == request.auth.uid
            || !incoming().keys().contains('userId'))
        && incoming().createdAt == request.time;
      allow update: if (
        isOwnerOrAdmin(existing().restaurantId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'updatedAt', 'paymentStatus', 'acceptedAt',
          'rejectedAt', 'rejectionReason'
        ])
      ) || (
        isSignedIn() && existing().userId == request.auth.uid
        && existing().status == 'received'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status == 'cancelled'
      );
    }

    // ─── COUPONS ─────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow get: if isSignedIn() && isOwnerOrAdmin(resource.data.restaurantId);
      allow list: if isSignedIn() && isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().code is string && incoming().code.size() <= 20
        && incoming().value is number && incoming().value >= 0
        && incoming().type in ['fixed', 'percent']
        && incoming().createdAt == request.time;
      allow update: if (
        isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId
      ) || (
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount'])
        && incoming().usageCount == existing().usageCount + 1
      );
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── OVOS DE OURO ────────────────────────────────────────────────────────
    match /ovos_de_ouro_participants/{restaurantId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(restaurantId)
        && incoming().restaurantId == restaurantId
        && incoming().acceptedAt == request.time;
      allow update, delete: if isOwnerOrAdmin(restaurantId);
    }

    match /dish_ratings/{ratingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dishId is string
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().year == request.time.date().year();
      allow update, delete: if false;
    }

    match /ovos_de_ouro_votes/{voteId} {
      allow get: if true;
      allow list: if isOwnerOrAdmin(resource.data.restaurantId) || isPlatformAdmin();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().orderId is string
        && incoming().restaurantRating is number
        && incoming().restaurantRating >= 1 && incoming().restaurantRating <= 5
        && incoming().year == request.time.date().year();
      allow update, delete: if false;
    }

    // ─── CUSTOMER RATINGS (restaurante avalia cliente) ──────────────────────
    match /customer_ratings/{ratingId} {
      allow read: if isPlatformAdmin() || isOwnerOrAdmin(resource.data.restaurantId);
      allow list: if isPlatformAdmin();
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().customerPhoneClean is string
        && incoming().customerPhone is string
        && incoming().restaurantId is string
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if false;
    }

    // ─── CASHIER SESSIONS ────────────────────────────────────────────────────
    match /cashier_sessions/{sessionId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().openedAt == request.time;
      allow update: if isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId;
      allow delete: if false;
    }

    // ─── DELIVERY SETTINGS (singleton /deliverySettings/{restaurantId}) ─────
    match /deliverySettings/{restaurantId} {
      allow read: if true;
      allow create, update: if isOwnerOrAdmin(restaurantId);
      allow delete: if false;
    }

    // ─── LOYALTY PROFILES ────────────────────────────────────────────────────
    match /loyalty_profiles/{profileId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId)
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().customerId is string
        && incoming().points is number;
      allow update: if isOwnerOrAdmin(existing().restaurantId);
      allow delete: if false;
    }

    // ─── NEWSLETTER SUBSCRIBERS ──────────────────────────────────────────────
    match /newsletter_subscribers/{subId} {
      allow create: if isSignedIn()
        && incoming().email is string
        && incoming().subscribedAt == request.time;
      allow read, list: if isPlatformAdmin();
      allow update, delete: if false;
    }

    // ─── TEST (connection health check) ──────────────────────────────────────
    match /test/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
