rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function runsRestaurant(restaurantId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId
             == request.auth.uid;
    }
    function isOwnerOrAdmin(restaurantId) {
      return runsRestaurant(restaurantId) || isPlatformAdmin();
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default deny
    match /{document=**} { allow read, write: if false; }

    // ─── RESTAURANTS ─────────────────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().slug.matches('^[a-z0-9-]+$')
        && (incoming().createdAt is timestamp || incoming().createdAt is string);
      allow update: if isOwnerOrAdmin(restaurantId)
        && incoming().ownerId == existing().ownerId;
      allow delete: if isOwnerOrAdmin(restaurantId);
    }

    // ─── CATEGORIES ──────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().name is string && incoming().name.size() <= 50
        && incoming().order is number;
      allow update, delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── PRODUCTS ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().price is number && incoming().price >= 0;
      allow update: if isOwnerOrAdmin(existing().restaurantId);
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isPlatformAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().keys().hasOnly(['full_name', 'role', 'createdAt', 'pwaInstallPending',
                                      'onboardingComplete', 'signupIntent', 'whatsapp'])
        && incoming().role == 'customer';
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys()
             .hasOnly(['full_name', 'profile_image_url', 'updatedAt', 'role', 'pwaInstallPending',
                       'favorites', 'onboardingComplete', 'createdAt', 'signupIntent',
                       'whatsapp', 'fcmToken', 'lastActiveAt', 'notifPreferences'])
        && (!('role' in incoming())
            || incoming().role == existing().role
            || (existing().role == 'customer' && incoming().role == 'restaurant'));
      allow delete: if false;
    }

    // ─── TABLES ──────────────────────────────────────────────────────────────
    match /tables/{tableId} {
      // Leitura pública: necessária ao fluxo de QR Code (o guest precisa saber
      // que a mesa existe para pedir). NOTA: regras do Firestore não fazem
      // redação por campo, então currentOrderId/lastCustomerCount ficam
      // visíveis aqui — para eliminá-los seria preciso mover esses campos
      // para uma subcoleção de escrita restrita.
      allow read: if true;

      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().restaurantId is string
        && incoming().number is number;

      // Update: dono/admin precisa preservar o restaurantId. Usar incoming()
      // aqui permitiria a um dono de restaurante A "sequestrar" uma mesa do
      // restaurante B, bastando escrever restaurantId = A no documento.
      allow update: if (
        isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId
      ) || (
        // Guest dine-in logado (CheckoutPage): marca a mesa como ocupada ao
        // pedir pelo QR. Nao pode alterar mais nada nem trocar o dono da mesa.
        // Exige login de proposito: permitir anonimos daria a qualquer
        // visitante o poder de marcar todas as mesas como ocupadas.
        isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentOrderId'])
        && incoming().status == 'occupied'
        && incoming().restaurantId == existing().restaurantId
      );

      // delete usava incoming(), que não existe no delete — a regra era
      // inalcançável (ninguém conseguia deletar). Baseia-se em existing().
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── ORDERS ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow get: if isOwnerOrAdmin(resource.data.restaurantId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isOwnerOrAdmin(resource.data.restaurantId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Criação de pedido é EXCLUSIVA do Admin SDK, via POST /api/orders.
      // O servidor lê o preço real do catálogo, confere cupom e debita
      // fidelidade. Permitir escrita do cliente deixaria o total, o unitPrice
      // e o saldo de pontos sob controle do navegador — inclusive pedido de
      // total 0. O Admin SDK nao passa por estas regras.
      allow create: if false;
      allow update: if (
        isOwnerOrAdmin(existing().restaurantId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'updatedAt', 'paymentStatus', 'acceptedAt',
          'rejectedAt', 'rejectionReason'
        ])
      ) || (
        isSignedIn() && existing().userId == request.auth.uid
        && existing().status == 'received'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status == 'cancelled'
      );
    }

    // ─── COUPONS ─────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow get: if isSignedIn() && isOwnerOrAdmin(resource.data.restaurantId);
      allow list: if isSignedIn() && isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().code is string && incoming().code.size() <= 20
        && incoming().value is number && incoming().value >= 0
        && incoming().type in ['fixed', 'percent']
        && incoming().createdAt == request.time;
      allow update: if (
        isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId
      ) || (
        // Client increments usageCount: must be signed in, active, within limit, increment by exactly 1
        isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['usageCount'])
        && existing().isActive == true
        && (existing().usageLimit == null || existing().usageCount < existing().usageLimit)
        && incoming().usageCount == existing().usageCount + 1
      );
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── OVOS DE OURO ────────────────────────────────────────────────────────
    match /ovos_de_ouro_participants/{restaurantId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(restaurantId)
        && incoming().restaurantId == restaurantId
        && incoming().acceptedAt == request.time;
      allow update, delete: if isOwnerOrAdmin(restaurantId);
    }

    match /dish_ratings/{ratingId} {
      allow get: if isOwnerOrAdmin(resource.data.restaurantId);
      allow list: if isPlatformAdmin();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dishId is string
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().year == request.time.date().year();
      allow update, delete: if false;
    }

    match /ovos_de_ouro_votes/{voteId} {
      allow get: if isSignedIn();
      allow list: if isOwnerOrAdmin(resource.data.restaurantId) || isPlatformAdmin();
      // Document ID = orderId (guarantees one vote per order per user)
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().orderId == voteId
        && incoming().orderId is string
        && incoming().restaurantId is string
        && incoming().restaurantRating is number
        && incoming().restaurantRating >= 1 && incoming().restaurantRating <= 5
        && incoming().year == request.time.date().year();
      allow update, delete: if false;
    }

    // ─── CUSTOMER RATINGS (restaurante avalia cliente) ──────────────────────
    match /customer_ratings/{ratingId} {
      allow read: if isPlatformAdmin() || isOwnerOrAdmin(resource.data.restaurantId);
      allow list: if isPlatformAdmin();
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().customerPhoneClean is string
        && incoming().customerPhone is string
        && incoming().restaurantId is string
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if false;
    }

    // ─── CASHIER SESSIONS ────────────────────────────────────────────────────
    match /cashier_sessions/{sessionId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().openedAt == request.time;
      allow update: if isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId;
      allow delete: if false;
    }

    // ─── DELIVERY SETTINGS (singleton /deliverySettings/{restaurantId}) ─────
    match /deliverySettings/{restaurantId} {
      allow read: if true;
      allow create, update: if isOwnerOrAdmin(restaurantId);
      allow delete: if false;
    }

    // ─── INGREDIENTS (insumos) ───────────────────────────────────────────────
    match /ingredients/{ingredientId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().unit is string
        && incoming().costPerUnit is number && incoming().costPerUnit >= 0
        && incoming().stock is number && incoming().stock >= 0;
      allow update: if isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId;
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── RECIPE SHEETS (ficha técnica) ───────────────────────────────────────
    match /recipe_sheets/{recipeId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().productId is string
        && incoming().ingredients is list
        && incoming().ingredients.size() <= 100;
      allow update: if isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId;
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── INGREDIENT MOVEMENTS (movimentações de estoque) ─────────────────────
    match /ingredient_movements/{movementId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().ingredientId is string
        && incoming().type in ['purchase', 'sale', 'adjustment', 'waste']
        && incoming().quantity is number
        && incoming().createdAt is string;
      allow update, delete: if false;
    }

    // ─── LOYALTY PROFILES ────────────────────────────────────────────────────
    match /loyalty_profiles/{profileId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId)
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if incoming().customerId is string
        && incoming().pointsBalance is number
        && (isOwnerOrAdmin(incoming().restaurantId)
            || (isSignedIn() && incoming().customerId == request.auth.uid));
      // O cliente pode atualizar o proprio nome, mas NAO o saldo: pontos sao
      // creditados pelo dono quando o pedido e aceito (awardLoyaltyPoints) e
      // debitados pelo servidor em /api/orders. Permitir pointsBalance aqui
      // deixava o cliente se auto-atribuir pontos e resgatar recompensas que
      // nunca ganhou.
      allow update: if isOwnerOrAdmin(existing().restaurantId)
        || (isSignedIn() && existing().customerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys()
                 .hasOnly(['customerName']));
    }

    // ─── NEWSLETTER SUBSCRIBERS ──────────────────────────────────────────────
    match /newsletter_subscribers/{subId} {
      allow create: if isSignedIn()
        && incoming().email is string
        && incoming().subscribedAt == request.time;
      allow read, list: if isPlatformAdmin();
      allow update, delete: if false;
    }

    // ─── STREAKS (daily order streaks) ────────────────────────────────────────
    match /streaks/{userId} {
      allow read: if request.auth.uid == userId || isPlatformAdmin();
      allow write: if request.auth.uid == userId;
    }

    // ─── ACHIEVEMENTS ─────────────────────────────────────────────────────────
    match /achievements/{userId} {
      allow read: if request.auth.uid == userId || isPlatformAdmin();
      allow write: if request.auth.uid == userId;
    }

    // ─── PLATFORM LOYALTY ──────────────────────────────────────────────────────
    match /platform_loyalty/{userId} {
      allow read: if request.auth.uid == userId || isPlatformAdmin();
      allow write: if request.auth.uid == userId;
    }

    // ─── WHATSAPP CONVERSATIONS (server-side only via Admin SDK) ──────────────
    match /whatsapp_conversations/{convId} {
      allow read: if isPlatformAdmin();
      allow write: if false; // Admin SDK only
    }

    // ─── TEST (connection health check) ──────────────────────────────────────
    match /test/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ─── SYSTEM HEALTH (escrito pelo cron /api/cron/health via Admin SDK) ────
    match /system_health/{document} {
      allow read, list: if isPlatformAdmin();
      allow write: if false; // Admin SDK only
    }

    match /system_checks/{document} {
      allow read, list: if isPlatformAdmin();
      allow write: if false; // Admin SDK only
    }

    // ─── FLASH DEALS (promoções relâmpago) ──────────────────────────────────
    match /flash_deals/{dealId} {
      allow read: if true;
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().restaurantId is string
        && incoming().productId is string
        && incoming().discountPercent is number
        && incoming().discountPercent > 0 && incoming().discountPercent <= 90
        && incoming().expiresAt is string;
      allow update: if isOwnerOrAdmin(existing().restaurantId)
        && incoming().restaurantId == existing().restaurantId;
      allow delete: if isOwnerOrAdmin(existing().restaurantId);
    }

    // ─── LABELS (selos/emojis customizados) ─────────────────────────────────
    match /labels/{labelId} {
      allow read, list: if isOwnerOrAdmin(resource.data.restaurantId);
      allow create: if isOwnerOrAdmin(incoming().restaurantId)
        && incoming().emoji is string
        && incoming().text is string;
      allow update, delete: if isOwnerOrAdmin(existing().restaurantId);
    }
  }
}
