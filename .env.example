# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Required for processing donations via PIX.
# Generate at https://www.mercadopago.com.br/developers/panel
# Use a token from the platform's Mercado Pago account (conta ME da plataforma).
MERCADO_PAGO_ACCESS_TOKEN="MY_ACCESS_TOKEN"

# SENTRY_DSN: Required for Sentry error monitoring.
# Create a Sentry account at https://sentry.io and get your DSN from Project Settings > Client Keys (DSN).
VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Optional: Sentry source map upload (for readable stack traces in production).
# Create an auth token at https://sentry.io/settings/account/api/auth-tokens/
# Requires "Project: Releases" and "Project: Source Maps" permissions.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional: API_SECRET_KEY for protecting backend AI/costly endpoints.
# Only needed in production (Vercel). In dev, auth is skipped.
# Use a strong random string and share with your frontend via env var.
# If not set, falls back to GEMINI_API_KEY for backwards compatibility.
API_SECRET_KEY=""
