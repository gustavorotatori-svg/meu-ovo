# ═══════════════════════════════════════════════════════════
# MEU OVO — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ═══════════════════════════════════════════════════════════

# ─── OBRIGATÓRIAS ─────────────────────────────────────────

# Gemini API Key (Google AI Studio)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# URL da aplicação (usado para CORS, links internos, FCM)
# Em produção: https://seu-dominio.com
# Em dev: http://localhost:3000
APP_URL="http://localhost:3000"

# Chave PIX da plataforma (para doações e caixinha social)
# Aceita: CPF, CNPJ, email, telefone ou chave aleatória
VITE_PLATFORM_PIX_KEY=""

# Firebase Service Account Key (JSON completo, em base64 ou string)
# Obtenha em: Firebase Console > Configurações > Contas de Serviço > Gerar nova chave
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ─── SEGURANÇA ────────────────────────────────────────────

# Secret para autenticar endpoints da API (IA, WhatsApp webhook)
# Use um string aleatório forte — gere com: openssl rand -hex 32
API_SECRET_KEY=""

# Secret para autenticar webhook do WhatsApp (Evolution API, Z-API, etc.)
WEBHOOK_SECRET=""

# ─── MONITORAMENTO (opcional) ─────────────────────────────

# Sentry DSN — para monitoramento de erros
# Obtenha em: https://sentry.io > Project Settings > Client Keys
VITE_SENTRY_DSN=""

# Sentry Auth Token (para upload de source maps)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── ANALYTICS (substituir no index.html) ─────────────────
# Google Analytics Measurement ID (G-XXXXXXXXXX)
# Meta Pixel ID (XXXXXXXXXXXXXXXXX)
# Substituir diretamente no index.html nas tags gtag e fbq
