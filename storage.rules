rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all restaurant content (new + legacy paths)
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true;
    }

    // ─── ESCRITA: BLOQUEADA NO CLIENT ───────────────────────────────────────
    // A versao anterior permitia escrita com:
    //     allow write: if request.auth.uid == ownerUid
    // onde `ownerUid` era um SEGMENTO DO PATH controlado pelo cliente. Como o
    // proprio cliente escrevia o proprio uid no caminho, a condicao era sempre
    // verdadeira: qualquer usuario autenticado escrevia em qualquer
    // restaurante. Pior, a regra nao checava ownerId no Firestore.
    //
    // Hoje o app NAO usa Firebase Storage para upload (as imagens dos produtos
    // sao salvas como base64 no Firestore e src/services/storageService.ts nao
    // tem nenhum chamador). Negar a escrita encerra o vetor sem quebrar nada.
    //
    // Para reabilitar upload no futuro, faca-lo por um endpoint autenticado
    // (/api/upload) usando o Admin SDK, que valida
    // restaurants/{id}.ownerId == request.auth.uid, e NAO pela regra do Storage.
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow write: if false;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}