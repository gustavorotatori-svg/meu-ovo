rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all restaurant content (new + legacy paths)
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true;
    }

    // Writes restricted to the restaurant OWNER (path segment ownerUid)
    // paths: restaurants/{restaurantId}/{ownerUid}/products|categories/...
    match /restaurants/{restaurantId}/{ownerUid}/{allPaths=**} {
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.uid == ownerUid;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}