rules_version = '2';
service firebase.cloud.storage {
  match /b/{bucket}/o {
    // Public read access for all restaurant images
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId))
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth.uid == firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.ownerId;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
